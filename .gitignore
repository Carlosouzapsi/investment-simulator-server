# Arquivos de dependências
# Geralmente, a pasta node_modules é recriada com 'npm install'
node_modules/
*/node_modules/

# Arquivos de log
# Logs podem conter informações sensíveis e crescer muito em tamanho
*.log
logs/
*.log.*
npm-debug.log*
yarn-debug.log*
yarn-error.log*
lerna-debug.log*

# Arquivos de ambiente
# Contêm segredos e configurações específicas do ambiente (local, dev, prod)
.env
.env.*
!.env.example

# Diretórios de build e produção
# São gerados a partir do código fonte e não devem ser versionados
dist/
build/
.next/
.nuxt/
.out/

# Cobertura de testes
# Gerado pelos testes e não faz parte do código fonte
coverage/
*/coverage/

# Arquivos de sistema operacional
.DS_Store
Thumbs.db

# Arquivos do editor
.vscode/
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Dados do MongoDB local (se estiverem dentro do projeto)
# A pasta 'data' que vi na sua estrutura parece ser do mongo
data/